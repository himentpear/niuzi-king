{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "niuzi-king",
  "account_id": "135a0bc953da5d5776e4cb08fb0704f2",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_WORLD",
        "class_name": "GameWorld"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameWorld"
      ]
    }
  ]
}
